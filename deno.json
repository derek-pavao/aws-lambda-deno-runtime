{
  "workspace": [
    "./aws-lambda-deno-runtime",
    "./example-lambda"
  ],
  "tasks": {
    "example-lambda:dev": "deno run --allow-env ./example-lambda/main.ts",
    "example-lambda:compile:x86-linux": "rm -rf ./dist/example-lambda/x86-linux && deno compile --allow-env --allow-net -o ./dist/example-lambda/x86-linux/bootstrap --target x86_64-unknown-linux-gnu ./example-lambda/main.ts",
    "example-lambda:compile:arm-linux": "rm -rf ./dist/example-lambda/arm-linux && deno compile --allow-env --allow-net -o ./dist/example-lambda/arm-linux/bootstrap --target aarch64-unknown-linux-gnu ./example-lambda/main.ts",
    "example-lambda:compile:arm-mac": "rm -rf ./dist/example-lambda/arm-mac && deno compile --allow-env --allow-net -o ./dist/example-lambda/arm-mac/bootstrap --target aarch64-apple-darwin ./example-lambda/main.ts",
    "example-lambda:compile:all": "rm -rf ./dist/example-lambda && deno run example-lambda:compile:x86-linux & deno run example-lambda:compile:arm-linux & deno run example-lambda:compile:arm-mac"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@types/lodash": "npm:@types/lodash@^4.17.24"
  }
}
